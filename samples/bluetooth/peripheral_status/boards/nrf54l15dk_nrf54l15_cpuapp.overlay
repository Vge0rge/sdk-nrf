/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &storage_partition;

&cpuapp_rram {
	partitions {
		b0_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "nsib";
			reg = <0x0 DT_SIZE_K(32)>;
		};

		s0_partition: slot0_partition: partition@8000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x8000 DT_SIZE_K(724)>;
		};

		s1_partition: slot1_partition: partition@bd000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0xbd000 DT_SIZE_K(724)>;
		};

		storage_partition: partition@172000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x172000 DT_SIZE_K(44)>;
		};
	};
};
